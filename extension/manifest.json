{
  "manifest_version": 3,
  "name": "Minecraftify Listings",
  "version": "1.0.0",
  "description": "Replaces real estate listing photos with AI-generated Minecraft versions.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Minecraftify"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zillow.com/*",
        "*://*.redfin.com/*",
        "*://*.redfin.ca/*",
        "*://*.realtor.com/*",
        "*://*.realtor.ca/*",
        "*://*.trulia.com/*",
        "*://*.homes.com/*",
        "*://*.compass.com/*",
        "*://*.apartments.com/*",
        "*://*.rightmove.co.uk/*",
        "*://*.zoopla.co.uk/*",
        "*://*.onthemarket.com/*",
        "*://*.realestate.com.au/*",
        "*://*.domain.com.au/*",
        "*://*.idealista.com/*",
        "*://*.airbnb.com/*"
      ],
      "js": [
        "canon.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
